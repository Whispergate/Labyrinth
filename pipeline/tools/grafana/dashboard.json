            { "jsonPath": "$.litterbox.scans[*].timestamp", "name": "time", "type": "time" },
            { "jsonPath": "$.litterbox.scans[*].detection_rate", "name": "detection_rate", "type": "number" }
          ],
          "method": "GET",
          "urlPath": "/metrics.json",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "marcusolsson-json-datasource", "uid": "maas-json" },
      "description": "Engine vs payload detection matrix - green=clean, red=detected",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "center",
            "cellOptions": {
              "mode": "gradient",
              "type": "color-background"
            },
            "filterable": true,
            "inspect": false
          },
          "mappings": [
            { "options": { "false": { "color": "green", "index": 0, "text": "CLEAN" } }, "type": "value" },
            { "options": { "true": { "color": "red", "index": 1, "text": "DETECTED" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 10 },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "Engine" }]
      },
      "title": "Detection Heatmap",
      "targets": [
        {
          "datasource": { "type": "marcusolsson-json-datasource", "uid": "maas-json" },
          "fields": [
            { "jsonPath": "$.litterbox.engine_payload_matrix", "name": "matrix", "type": "string" }
          ],
          "method": "GET",
          "urlPath": "/metrics.json",
          "refId": "A"
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "marcusolsson-json-datasource", "uid": "maas-json" },
      "description": "Build profiles sorted by lowest average detection rate",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": true,
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.25 },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 0.75 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "avg_rate" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.cellOptions", "value": { "mode": "gradient", "type": "color-background" } },
              { "id": "displayName", "value": "Avg Detection Rate" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "profile" },
            "properties": [
              { "id": "displayName", "value": "Profile" },
              { "id": "custom.width", "value": 180 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "samples" },
            "properties": [
              { "id": "displayName", "value": "Scans" }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 10 },
      "id": 7,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "Avg Detection Rate" }]
      },
      "title": "Best Performing Profiles",
      "targets": [
        {
          "datasource": { "type": "marcusolsson-json-datasource", "uid": "maas-json" },
          "fields": [
            { "jsonPath": "$.litterbox.profile_detection_rates", "name": "profiles", "type": "string" }
          ],
          "method": "GET",
          "urlPath": "/metrics.json",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              { "destinationType": "number", "targetField": "avg_rate" }
            ]
          }
        },
        {
          "id": "sortBy",
          "options": { "fields": {}, "sort": [{ "field": "avg_rate" }] }
        }
      ],
      "type": "table"
    },
